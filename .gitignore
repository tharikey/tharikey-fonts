# Build artifact — CI compiles it from the fragments and pushes it to R2; not committed (the YAML
# fragments are the source of truth, and `generatedAt` would churn the diff daily).
/dist/

__pycache__/
*.pyc
.DS_Store
.venv/

# Specimen generator scratch — downloaded/unpacked fonts cached by tools/build_specimens.py. The PNGs it
# renders into foundries/*/assets/ ARE committed; this is just the re-download/unpack cache.
.cache/
